---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>สวัสดี, I'm Nitipat</h1>
			<p>
				{SITE_AUTHOR} — personal notes and a small blog.
				เว็บส่วนตัวสำหรับบันทึกสั้น ๆ เป็นภาษาไทยและอังกฤษ
			</p>
			<ul>
				<li><a href="/blog/">Blog</a> — posts</li>
				<li><a href="/about/">About</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
