---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="masthead">
		<div class="kicker">Personal Site</div>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<nav class="internal-links" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="https://nitipatl.github.io/running-events/">Running</HeaderLink>
		</nav>
	</div>
	<div class="header-aside">
		<div class="stamp-logo" aria-hidden="true">
			<div class="star">★</div>
			<span>Hello<br />Every Day</span>
		</div>
		<a
			class="gh"
			href="https://github.com/nitipatl"
			target="_blank"
			rel="noopener noreferrer"
		>
			<span class="sr-only">GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
	</div>
</header>
<style>
	header {
		max-width: var(--max);
		margin: 0 auto;
		padding: 22px 16px 14px;
		border-bottom: 2px solid var(--rule);
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px;
	}
	.masthead {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.site-title {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 6vw, 2.35rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 0.95;
		color: var(--ink);
		text-decoration: none;
	}
	.site-title:hover {
		color: var(--ink);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 12px;
	}
	nav :global(a) {
		background: transparent;
		border: 1.5px solid var(--ink);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 5px 11px;
		border-radius: 0;
		text-decoration: none;
		transition: background 0.12s, color 0.12s, box-shadow 0.12s, transform 0.1s;
	}
	nav :global(a:hover) {
		background: var(--bg-soft);
		color: var(--ink);
	}
	nav :global(a:active) {
		transform: translate(1px, 1px);
	}
	nav :global(a.active) {
		background: var(--ink);
		color: var(--bg);
		box-shadow: none;
	}
	.header-aside {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
	}
	.stamp-logo {
		width: 64px;
		height: 64px;
		border: 2.5px solid var(--ink);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		text-align: center;
		transform: rotate(-8deg);
		background: var(--bg);
		box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.08);
	}
	.stamp-logo .star {
		font-size: 0.7rem;
		line-height: 1;
		color: var(--orange);
	}
	.stamp-logo span {
		font-family: var(--font-display);
		font-size: 0.48rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.15;
		padding: 0 6px;
	}
	.gh {
		color: var(--muted);
		display: flex;
		padding: 2px;
		text-decoration: none;
	}
	.gh:hover {
		color: var(--ink);
	}
	@media (min-width: 480px) {
		header {
			padding: 28px 18px 16px;
		}
	}
	@media (max-width: 420px) {
		.gh {
			display: none;
		}
	}
</style>
